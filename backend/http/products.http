@baseUrl = http://localhost:8080/api

### List products
GET {{baseUrl}}/products

### List products with search and paging
GET {{baseUrl}}/products?search=beras&page=1&limit=5

### List products, page beyond last
GET {{baseUrl}}/products?page=99&limit=5

### List products, invalid limit (400)
GET {{baseUrl}}/products?limit=abc

### Get product (200)
GET {{baseUrl}}/products/1

### Get product, not found (404)
GET {{baseUrl}}/products/9999

### Create product (201)
# @name createProduct
POST {{baseUrl}}/products
Content-Type: application/json

{
  "sku": "TST-002",
  "name": "Produk Uji",
  "price": 12000
}

### Create product, duplicate sku (409 SKU_EXISTS)
POST {{baseUrl}}/products
Content-Type: application/json

{
  "sku": "TST-001",
  "name": "Produk Uji Lagi",
  "price": 12000
}

### Create product, validation error (400)
POST {{baseUrl}}/products
Content-Type: application/json

{
  "sku": " ",
  "price": -1
}

### Create product, stock is not allowed (400)
POST {{baseUrl}}/products
Content-Type: application/json

{
  "sku": "TST-002",
  "name": "Produk Uji",
  "price": 1000,
  "stock": 50
}

### Update product (200)
PUT {{baseUrl}}/products/{{createProduct.response.body.$.id}}
Content-Type: application/json

{
  "sku": "TST-001",
  "name": "Produk Uji v2",
  "price": 15000,
  "is_active": false
}

### Update product, missing is_active (400)
PUT {{baseUrl}}/products/{{createProduct.response.body.$.id}}
Content-Type: application/json

{
  "sku": "TST-001",
  "name": "Produk Uji v2",
  "price": 15000
}

### Update product, not found (404)
PUT {{baseUrl}}/products/9999
Content-Type: application/json

{
  "sku": "TST-404",
  "name": "Tidak Ada",
  "price": 1,
  "is_active": true
}

### Delete product with history (409 PRODUCT_HAS_HISTORY)
DELETE {{baseUrl}}/products/1

### Delete product (204)
DELETE {{baseUrl}}/products/{{createProduct.response.body.$.id}}

### Delete product again (404)
DELETE {{baseUrl}}/products/{{createProduct.response.body.$.id}}
